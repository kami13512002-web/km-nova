{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "km-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "05596f39-db00-48fc-bb5d-9712756310a8","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6b1133c465934f2c91f7d4fa5893337e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
